datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  telegramId   String?  @unique
  apiKey       String   @unique @default(uuid())
  createdAt    DateTime @default(now())

  session      LinkedInSession?
  config       UserConfig?
  workflowRuns WorkflowRun[]
  outreachLogs OutreachLog[]
  activityLogs ActivityLog[]
  dailyStats   DailyStats[]
  companyQueue CompanyQueue[]
  searchJobs   SearchJob[]
  campaigns    Campaign[]
  emailLookups EmailLookup[]
}

/// The LinkedIn session the server makes Voyager calls with.
///
/// Holds the **whole cookie jar**, not an auth token. `li_at` alone is not a
/// session: without `JSESSIONID`, `bcookie`, `bscookie`, `lidc` and `li_rm` the
/// request reads to LinkedIn's risk engine like a stolen cookie. The old shape
/// here was `csrfToken` + `liAtCookie` and nothing else, which could not
/// construct a working `CookieJar` — and nothing ever wrote it. See
/// docs/adr/0002-full-cookie-jar.md.
///
/// `cookies` is a `CookieExport` map, rewritten after every successful call
/// because `JSESSIONID` (the CSRF token) and `lidc` rotate during normal use.
/// It is deliberately **not** rewritten after a fatal response — that would
/// overwrite a good jar with a dead one and force a needless re-extraction.
///
/// `userAgent` travels with the jar. A jar harvested from one browser and
/// replayed under a different user-agent is a mismatched fingerprint.
model LinkedInSession {
  id             String    @id @default(uuid())
  userId         String    @unique
  cookies        Json
  userAgent      String
  timezoneOffset Float     @default(5.5)
  isValid        Boolean   @default(true)
  /// Why the session was last invalidated, for the dashboard and the bot.
  invalidReason  String?
  /// When the jar was last pushed from a browser.
  importedAt     DateTime  @default(now())
  lastChecked    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserConfig {
  id                 String  @id @default(uuid())
  userId             String  @unique
  keywords           String  @default("Werkstudent, Internship, Praktikum")
  locations          String  @default("Erlangen, Nuremberg, Munich")
  dailyLimit         Int     @default(15)
  llmProvider        String  @default("ollama")
  llmApiKey          String?
  llmUrl             String  @default("http://localhost:11434")
  llmModel           String  @default("qwen2.5:1.5b")
  userContext        String? @db.Text
  targetGeoId        String  @default("101282230")
  emailFinderEnabled Boolean @default(true)

  // ─── Outreach ──────────────────────────────────────────────────
  // SMTP credentials for campaign sending. The standalone mailer took these
  // in the body of every /send request, which put an app password through
  // the browser and into request logs on each call. Stored once instead.
  //
  // smtpPassword is a Google app password, not the account password. It is
  // stored encrypted — see server/src/lib/secretBox.ts.
  smtpUser     String?
  smtpPassword String?
  smtpFromName String?

  // Appended to every generated email. The mailer hardcoded one person's
  // name, phone and LinkedIn URL into the send loop and stripped any
  // signature the model wrote using a regex over that same name.
  emailSignature String? @db.Text

  // The CV attached to every campaign's emails. Held per user rather than
  // per campaign: the mailer stored it on Campaign and its uploads/ dir ended
  // up with fifteen byte-identical copies of the same PDF, one per campaign,
  // none of which anything ever deleted.
  resumeFileName String?
  resumeFilePath String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id            String   @id @default(uuid())
  companyId     String   @unique
  name          String
  slug          String?
  employeeCount Int?
  industry      String?
  website       String?
  processedAt   DateTime @default(now())

  profiles Profile[]
}

model Profile {
  id              String   @id @default(uuid())
  profileId       String   @unique
  memberId        String?
  firstName       String
  lastName        String
  headline        String?  @db.Text
  about           String?  @db.Text
  location        String?
  linkedinUrl     String
  email           String?
  emailSource     String?
  emailValidation String?
  companyId       String?
  rawProfileJson  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  outreachLogs     OutreachLog[]
  campaignContacts CampaignContact[]
  emailLookups     EmailLookup[]
}

/// A request to find one profile's work email, and the record of how it went.
///
/// This is a queue, not a log: the work is executed by the Chrome extension,
/// which is offline most of the time — an MV3 service worker is killed after
/// ~30s idle and the WebSocket handshake requires a live `SearchJob`. So the
/// request cannot be pushed at a connected client; it has to sit somewhere
/// durable until a browser shows up and drains it. A BullMQ job would stall
/// and retry blindly against a worker that may not exist for hours.
///
/// Shaped after `ProfileUrl`, which already solved this in the scrape
/// pipeline: a status the client claims, an attempt count, the last error, and
/// a lease timestamp a sweeper can reclaim.
///
/// One row per (user, profile) — re-requesting resets the existing row rather
/// than stacking duplicates, so the table reads as "current state of finding
/// this person's email" and the dashboard can render progress straight from a
/// count. The found address is written to `Profile`, which is what the
/// dashboard and `CampaignContact` actually read; `email` here is the audit
/// copy of what this attempt produced.
model EmailLookup {
  id                  String    @id @default(uuid())
  userId              String
  profileId           String
  /// queued | dispatched | done | failed
  status              String    @default("queued")
  attempts            Int       @default(0)
  /// Which executor took it: `extension` or `server`.
  claimedBy           String?
  /// May the server finish this with patterns + SMTP if no browser claims it?
  ///
  /// Default **false**, and that is the important part. The server can only
  /// reach the metered API and pattern+SMTP, so letting it pick up every
  /// unclaimed row means most profiles end as a `pattern_guess` — an answer
  /// weak enough to be misleading, produced before the extension (a real
  /// browser, where the provider captcha solves) ever had a turn. Opt in per
  /// request when you know no browser is coming.
  allowServerFallback Boolean   @default(false)
  email               String?
  emailSource         String?
  emailValidation     String?
  lastError           String?   @db.Text
  requestedAt         DateTime  @default(now())
  dispatchedAt        DateTime?
  completedAt         DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@index([userId, status])
  @@index([status, requestedAt])
}

model WorkflowRun {
  id           String    @id @default(uuid())
  userId       String
  workflowType String
  status       String    @default("idle")
  params       Json
  progress     Json?
  results      Json?
  errors       Json?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutreachLog {
  id        String   @id @default(uuid())
  userId    String
  profileId String?
  action    String
  status    String
  message   String?  @db.Text
  details   Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  level     String   @default("info")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyStats {
  id                 String @id @default(uuid())
  userId             String
  date               String
  connectionsSent    Int    @default(0)
  jobsFound          Int    @default(0)
  companiesProcessed Int    @default(0)
  targetsFound       Int    @default(0)
  emailsFound        Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CompanyQueue {
  id           String   @id @default(uuid())
  userId       String
  companyUrl   String
  searchPrompt String?
  maxResults   Int      @default(100)
  status       String   @default("pending") // pending | processing | completed | error
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchJob {
  id                 String   @id @default(uuid())
  userId             String
  status             String   @default("initializing") // initializing | collecting_urls | scraping | completed | paused_error
  limitRequested     Int
  qualifiedCount     Int      @default(0)
  currentBatchNumber Int      @default(1)
  searchParams       Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileUrls ProfileUrl[]
  connections ExtensionConnection[]
}

model ProfileUrl {
  id           String    @id @default(uuid())
  jobId        String
  batchNumber  Int
  url          String
  status       String    @default("queued") // queued | dispatched | scraping | scraped | failed_retryable | failed_permanent | skipped
  attempts     Int       @default(0)
  lastError    String?   @db.Text
  dispatchedAt DateTime?
  scrapedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  job     SearchJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profile ScrapedProfile?

  @@unique([jobId, url])
}

model ScrapedProfile {
  id           String   @id @default(uuid())
  profileUrlId String   @unique
  rawData      Json
  name         String
  headline     String?  @db.Text
  about        String?  @db.Text
  company      String?
  location     String?
  scrapedAt    DateTime @default(now())

  profileUrl ProfileUrl        @relation(fields: [profileUrlId], references: [id], onDelete: Cascade)
  decisions  ProfileDecision[]
}

model ProfileDecision {
  id                  String   @id @default(uuid())
  profileId           String
  email               String?
  emailSource         String?
  isQualified         Boolean  @default(false)
  qualificationReason String?  @db.Text
  decidedAt           DateTime @default(now())

  profile ScrapedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ExtensionConnection {
  id              String    @id @default(uuid())
  jobId           String
  socketId        String
  connectedAt     DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  disconnectedAt  DateTime?

  job SearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─── Outreach campaigns ──────────────────────────────────────────
//
// The mail side of the product: take profiles the pipeline already found,
// draft a personalised email per contact, and send them on a delay. Ported
// from the standalone Bulk Mail Sender, which read contacts from a CSV that
// had been exported from here by hand. Contacts now come from Profile
// directly, so the export/import round trip is gone.

model Campaign {
  id           String  @id @default(uuid())
  userId       String
  name         String
  status       String  @default("PENDING") // PENDING | SENDING | COMPLETE | STOPPED | FAILED
  emailSubject String
  fromName     String?
  commonPrompt String? @db.Text

  // Milliseconds between sends, picked uniformly from the range. Gmail will
  // rate-limit and eventually flag an account that sends without any pacing.
  minDelayMs Int @default(5000)
  maxDelayMs Int @default(10000)

  // Denormalised counters so the list screen does not aggregate per row.
  totalContacts Int @default(0)
  sentCount     Int @default(0)
  failedCount   Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts CampaignContact[]

  @@index([userId, createdAt])
}

model CampaignContact {
  id         String @id @default(uuid())
  campaignId String

  // Set when the contact came from the scraping pipeline, null for a CSV
  // import. SetNull rather than Cascade: deleting a profile must not erase
  // the record that we mailed them.
  profileId String?

  name        String
  email       String
  companyName String?
  description String? @db.Text

  // A draft the user edited by hand. Present means "send this verbatim" —
  // the LLM is skipped entirely for this contact.
  customSubject String?
  customBody    String? @db.Text

  // What was actually sent, kept so a campaign is auditable after the fact.
  sentSubject String?
  sentBody    String? @db.Text

  status       String    @default("PENDING") // PENDING | GENERATING | SENDING | SUCCESS | FAILED | SKIPPED
  errorMessage String?   @db.Text
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profile  Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // One send per profile per campaign. Without this, re-importing a
  // selection silently queues a second email to the same person.
  @@unique([campaignId, profileId])
  @@index([campaignId, status])
}
