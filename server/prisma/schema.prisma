datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  telegramId   String?  @unique
  apiKey       String   @unique @default(uuid())
  createdAt    DateTime @default(now())

  session      LinkedInSession?
  config       UserConfig?
  workflowRuns WorkflowRun[]
  outreachLogs OutreachLog[]
  activityLogs ActivityLog[]
  dailyStats   DailyStats[]
  companyQueue CompanyQueue[]
  searchJobs   SearchJob[]
  campaigns    Campaign[]
  emailLookups EmailLookup[]
  llmCredentials LlmCredential[]
}

/// One model the account can call, and the key to call it with.
///
/// `UserConfig.llmProvider` / `llmApiKey` / `llmUrl` / `llmModel` describe a
/// *single* model, so one exhausted free tier stopped every run. This table is
/// the ordered list that replaces it: the router walks it top to bottom and the
/// first credential that answers wins. The old columns are still read as a
/// last-resort chain entry, so an account that never adds a row here keeps
/// working exactly as before.
///
/// The point is free tiers. Gemini, OpenRouter, Groq and Cloudflare all give
/// away a daily quota; five of them in a row is a working budget, and a 429 on
/// one is a fact about that key at that minute, not about the run.
model LlmCredential {
  id     String @id @default(uuid())
  userId String
  /// What the user calls it in the list. Their own words — two Gemini keys from
  /// two Google accounts are otherwise indistinguishable in the UI.
  label  String

  /// `server` | `ollama` | `gemini` | `openrouter` | `groq` | `custom`.
  /// `custom` is any other OpenAI-compatible host (Cloudflare Workers AI,
  /// Together, a self-hosted vLLM) and is the reason `baseUrl` exists.
  provider String
  /// AES-256-GCM via `lib/secretBox.ts`, never plaintext at rest. Null for the
  /// providers that need no key (`server`, a local `ollama`).
  apiKey   String?
  baseUrl  String  @default("")
  model    String  @default("")

  /// Ascending. The order the user dragged them into, which is the order the
  /// waterfall tries them in.
  priority Int     @default(0)
  /// The user's own switch. Distinct from `cooldownUntil` (transient, ours) and
  /// from `disabledCode` (broken, needs them to act) so the UI can say which.
  enabled  Boolean @default(true)

  /// Skip this credential until then. Set from a 429's `Retry-After` where the
  /// provider sends one, otherwise from a per-code default. Null means ready.
  ///
  /// A cooldown is deliberately *not* a disable: a daily quota comes back, and
  /// a key that is retired on its first 429 is a free tier thrown away.
  cooldownUntil DateTime?
  /// Set when the failure needs a human — `LLM_AUTH` (wrong key),
  /// `LLM_MODEL_NOT_FOUND` (wrong model id). Retrying either on a timer only
  /// spends latency on a request that cannot succeed. Cleared on any edit.
  disabledCode  String?

  lastUsedAt    DateTime?
  lastErrorAt   DateTime?
  /// The `JobErrorCode` of the most recent failure, for the UI's status pill.
  lastErrorCode String?
  successCount  Int       @default(0)
  failureCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

/// The LinkedIn session the server makes Voyager calls with.
///
/// Holds the **whole cookie jar**, not an auth token. `li_at` alone is not a
/// session: without `JSESSIONID`, `bcookie`, `bscookie`, `lidc` and `li_rm` the
/// request reads to LinkedIn's risk engine like a stolen cookie. The old shape
/// here was `csrfToken` + `liAtCookie` and nothing else, which could not
/// construct a working `CookieJar` — and nothing ever wrote it. See
/// docs/adr/0002-full-cookie-jar.md.
///
/// `cookies` is a `CookieExport` map, rewritten after every successful call
/// because `JSESSIONID` (the CSRF token) and `lidc` rotate during normal use.
/// It is deliberately **not** rewritten after a fatal response — that would
/// overwrite a good jar with a dead one and force a needless re-extraction.
///
/// `userAgent` travels with the jar. A jar harvested from one browser and
/// replayed under a different user-agent is a mismatched fingerprint.
model LinkedInSession {
  id             String    @id @default(uuid())
  userId         String    @unique
  cookies        Json
  userAgent      String
  timezoneOffset Float     @default(5.5)
  isValid        Boolean   @default(true)
  /// Why the session was last invalidated, for the dashboard and the bot.
  invalidReason  String?
  /// When the jar was last pushed from a browser.
  importedAt     DateTime  @default(now())
  lastChecked    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserConfig {
  id                 String  @id @default(uuid())
  userId             String  @unique
  dailyLimit         Int     @default(15)
  /// `server` | `ollama` | `gemini` | `openrouter`.
  ///
  /// `server` means "this instance's built-in model", resolved from
  /// DEFAULT_LLM_URL / DEFAULT_LLM_MODEL. It is the default because the
  /// operator knows an address that works and a model that is installed, and a
  /// new user does not.
  ///
  /// This used to default to `ollama` at `http://localhost:11434` — which
  /// inside the container is the container. Every fresh account therefore
  /// pointed at nothing, and because an LLM failure was recorded as a
  /// rejection, a run would evaluate hundreds of profiles, qualify none, and
  /// report itself healthy. Measured on the VM 2026-08-09: 368 of 368.
  llmProvider        String  @default("server")
  llmApiKey          String?
  /// Empty unless the user picked an explicit provider. No localhost default:
  /// an address that is wrong in every containerised deployment is worse than
  /// a blank the preflight can complain about.
  llmUrl             String  @default("")
  llmModel           String  @default("")
  userContext        String? @db.Text
  emailFinderEnabled Boolean @default(true)

  /// The user's default evaluation criteria for a new run.
  ///
  /// Lived as a hardcoded `<textarea>` default in the extension popup, which
  /// meant it could not be edited without editing markup and was lost the
  /// moment the finder moved to the dashboard. Null falls back to
  /// `config/defaultPrompt.ts`.
  ///
  /// Per-run, not per-account, is the thing the run itself stores — this is
  /// only what the New run form is prefilled with.
  searchPrompt String? @db.Text

  // ─── Outreach ──────────────────────────────────────────────────
  // SMTP credentials for campaign sending. The standalone mailer took these
  // in the body of every /send request, which put an app password through
  // the browser and into request logs on each call. Stored once instead.
  //
  // smtpPassword is a Google app password, not the account password. It is
  // stored encrypted — see server/src/lib/secretBox.ts.
  // ─── LinkFinder ────────────────────────────────────────────────
  // The user's own LinkFinder API key (https://linkfinderai.com). Per-account
  // rather than an instance-wide env var: the credit balance is theirs, it is
  // theirs to top up, and a shared key would spend one user's credits on
  // another's lookups. Encrypted at rest — see server/src/lib/secretBox.ts.
  //
  // Null means the layer is off for this user; the lookup queue then goes
  // straight to the extension waterfall, exactly as it did before the key
  // existed.
  linkFinderApiKey String?

  /// When the user's LinkFinder pass was paused, and why.
  ///
  /// A pause is deliberate and sticky: out of credits or over the rate limit
  /// produces the same answer on every subsequent call, so continuing would
  /// burn the rest of the batch against a wall and report every profile as a
  /// miss. The queue holds instead, and **only the user resumes it** — from the
  /// banner on Results, after they have topped up. Nothing clears this on a
  /// timer, because nothing here can know when their credits came back.
  ///
  /// Null means running.
  linkFinderPausedAt DateTime?
  /// `no_credits` | `rate_limited` | `bad_key` — see LINKFINDER_PAUSE_REASONS
  /// in server/src/services/linkFinderAccount.service.ts, which owns the
  /// user-facing message for each.
  linkFinderPauseCode String?
  /// The provider's own words, shown collapsed under the message. Never the key.
  linkFinderPauseDetail String? @db.Text

  smtpUser     String?
  smtpPassword String?
  smtpFromName String?

  // Appended to every generated email. The mailer hardcoded one person's
  // name, phone and LinkedIn URL into the send loop and stripped any
  // signature the model wrote using a regex over that same name.
  emailSignature String? @db.Text

  // The CV attached to every campaign's emails. Held per user rather than
  // per campaign: the mailer stored it on Campaign and its uploads/ dir ended
  // up with fifteen byte-identical copies of the same PDF, one per campaign,
  // none of which anything ever deleted.
  resumeFileName String?
  resumeFilePath String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id            String   @id @default(uuid())
  companyId     String   @unique
  name          String
  slug          String?
  employeeCount Int?
  industry      String?
  website       String?
  processedAt   DateTime @default(now())

  profiles Profile[]
}

model Profile {
  id              String   @id @default(uuid())
  profileId       String   @unique
  memberId        String?
  firstName       String
  lastName        String
  headline        String?  @db.Text
  about           String?  @db.Text
  location        String?
  linkedinUrl     String
  email           String?
  emailSource     String?
  emailValidation String?
  companyId       String?
  rawProfileJson  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  outreachLogs     OutreachLog[]
  campaignContacts CampaignContact[]
  emailLookups     EmailLookup[]
}

/// A request to find one profile's work email, and the record of how it went.
///
/// This is a queue, not a log: the work is executed by the Chrome extension,
/// which is offline most of the time — an MV3 service worker is killed after
/// ~30s idle and the WebSocket handshake requires a live `SearchJob`. So the
/// request cannot be pushed at a connected client; it has to sit somewhere
/// durable until a browser shows up and drains it. A BullMQ job would stall
/// and retry blindly against a worker that may not exist for hours.
///
/// Shaped after `ProfileUrl`, which already solved this in the scrape
/// pipeline: a status the client claims, an attempt count, the last error, and
/// a lease timestamp a sweeper can reclaim.
///
/// One row per (user, profile) — re-requesting resets the existing row rather
/// than stacking duplicates, so the table reads as "current state of finding
/// this person's email" and the dashboard can render progress straight from a
/// count. The found address is written to `Profile`, which is what the
/// dashboard and `CampaignContact` actually read; `email` here is the audit
/// copy of what this attempt produced.
model EmailLookup {
  id                  String    @id @default(uuid())
  userId              String
  profileId           String
  /// Which press of "Find emails" this row belongs to.
  ///
  /// Rows are never deleted — a row is the record of a lookup, and re-running
  /// one upserts it in place — so a per-user count is a lifetime count. The
  /// dashboard's progress panel is about *this* batch ("39 selected, 35 found"),
  /// not about every lookup the account has ever run, and without a batch key
  /// there is no way to tell the two apart. Null on rows that predate the
  /// column; those are treated as one legacy batch.
  batchId             String?
  /// queued | dispatched | done | failed
  status              String    @default("queued")
  attempts            Int       @default(0)
  /// Leases that expired without the executor reporting anything.
  ///
  /// Separate from `attempts` because they are not the same event and must not
  /// share a budget. An attempt is a lookup that ran and came back empty; a
  /// reclaim is a browser that was closed, crashed or slept mid-lookup — the
  /// row was never actually worked. Counting those as attempts retired a row
  /// as `failed` after three closed laptops, having never once tried it.
  ///
  /// Still counted, and still bounded by `MAX_RECLAIMS`: a row that reliably
  /// kills whatever picks it up must not cycle through the queue forever.
  reclaims            Int       @default(0)
  /// Which executor took it: `extension` or `server`.
  claimedBy           String?
  /// May the server finish this with patterns + SMTP if no browser claims it?
  ///
  /// Default **false**, and that is the important part. The server can only
  /// reach the metered API and pattern+SMTP, so letting it pick up every
  /// unclaimed row means most profiles end as a `pattern_guess` — an answer
  /// weak enough to be misleading, produced before the extension (a real
  /// browser, where the provider captcha solves) ever had a turn. Opt in per
  /// request when you know no browser is coming.
  allowServerFallback Boolean   @default(false)
  /// Held for a manual push to the extension.
  ///
  /// Set when LinkFinder ran this row and found nothing. The address may still
  /// exist — the extension's browser waterfall knows people the API does not —
  /// but that path costs a real browser and the user's time, so it is not
  /// entered automatically. The row waits, visible and counted, until the user
  /// presses "Send to extension" on Results.
  ///
  /// While true no executor may claim the row: it is not queued work, it is a
  /// decision waiting on a person. `releaseHandoff` clears it for the whole
  /// batch at once.
  pendingHandoff      Boolean   @default(false)
  email               String?
  emailSource         String?
  emailValidation     String?
  lastError           String?   @db.Text
  requestedAt         DateTime  @default(now())
  dispatchedAt        DateTime?
  completedAt         DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@index([userId, status])
  @@index([userId, batchId])
  @@index([status, requestedAt])
  @@index([userId, pendingHandoff])
}

model WorkflowRun {
  id           String    @id @default(uuid())
  userId       String
  workflowType String
  status       String    @default("idle")
  params       Json
  progress     Json?
  results      Json?
  errors       Json?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutreachLog {
  id        String   @id @default(uuid())
  userId    String
  profileId String?
  action    String
  status    String
  message   String?  @db.Text
  details   Json?
  /// Which run found this profile, for the Results run filter.
  ///
  /// A plain column rather than a relation, deliberately: this row is what
  /// scopes a profile to a user, and deleting a run must never cascade into
  /// erasing the record that we found — or mailed — someone.
  searchJobId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([userId, searchJobId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  level     String   @default("info")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyStats {
  id                 String @id @default(uuid())
  userId             String
  date               String
  connectionsSent    Int    @default(0)
  jobsFound          Int    @default(0)
  companiesProcessed Int    @default(0)
  targetsFound       Int    @default(0)
  emailsFound        Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CompanyQueue {
  id           String   @id @default(uuid())
  userId       String
  companyUrl   String
  searchPrompt String?
  maxResults   Int      @default(100)
  status       String   @default("pending") // pending | processing | completed | error
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchJob {
  id                 String   @id @default(uuid())
  userId             String
  status             String   @default("initializing") // initializing | collecting_urls | scraping | completed | paused_error | paused_session
  limitRequested     Int
  qualifiedCount     Int      @default(0)
  currentBatchNumber Int      @default(1)
  searchParams       Json

  /// Why the run stopped, as a `JobErrorCode` — see server/src/errors/jobErrors.ts.
  /// Denormalised onto the job so the Runs list can say *why* in one line
  /// without joining the event log. Null while the run is healthy.
  failureCode   String?
  /// The provider's own words. Shown behind a disclosure, never as the headline.
  failureDetail String? @db.Text
  /// Provider, model, target and company as they were when the run started.
  /// A run that failed three days ago cannot be explained by settings the user
  /// has since changed.
  configSnapshot Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileUrls ProfileUrl[]
  connections ExtensionConnection[]
  events      JobEvent[]
}

/// The readable, per-run event log.
///
/// Not piped server logs — a curated record aimed at whoever started the run.
/// The budget is **20–40 rows for a 400-profile run**, and it is enforced
/// structurally rather than by convention: `@@unique([jobId, stage, code])`
/// means a repeated error can only ever `upsert` and increment `count`, so a
/// failure that recurs 300 times is one line reading "×300".
///
/// What is deliberately absent: per-profile fetches, and per-rejection rows.
/// Rejections are the bulk of the volume and the least informative thing an
/// operator can read.
///
/// Every write goes through `services/jobEvents.service.ts`. Calling
/// `prisma.jobEvent.create` directly at a call site is how the budget dies.
model JobEvent {
  id    String   @id @default(uuid())
  jobId String
  at    DateTime @default(now())
  /// `info` | `warn` | `error`
  level String   @default("info")
  /// `collect` | `scrape` | `qualify` | `publish` | `email`
  stage String
  /// A `JobErrorCode`, or a lifecycle key such as `RUN_STARTED`.
  code  String
  /// One plain sentence. No error codes, no stack traces, no jargon.
  message String  @db.Text
  /// The raw error, collapsed by default in the UI.
  detail  String? @db.Text
  /// Repeats roll up here rather than inserting another row.
  count   Int     @default(1)
  /// Who the event is about, when it is about a person.
  profileRef String?
  /// Bumped on every roll-up, so "last seen" is answerable.
  updatedAt DateTime @updatedAt

  job SearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stage, code])
  @@index([jobId, at])
}

model ProfileUrl {
  id           String    @id @default(uuid())
  jobId        String
  batchNumber  Int
  url          String
  status       String    @default("queued") // queued | dispatched | scraping | scraped | failed_retryable | failed_permanent | skipped
  attempts     Int       @default(0)
  lastError    String?   @db.Text
  dispatchedAt DateTime?
  scrapedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  job     SearchJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profile ScrapedProfile?

  @@unique([jobId, url])
}

model ScrapedProfile {
  id           String   @id @default(uuid())
  profileUrlId String   @unique
  rawData      Json
  name         String
  headline     String?  @db.Text
  about        String?  @db.Text
  company      String?
  location     String?
  scrapedAt    DateTime @default(now())

  profileUrl ProfileUrl        @relation(fields: [profileUrlId], references: [id], onDelete: Cascade)
  decisions  ProfileDecision[]
}

model ProfileDecision {
  id                  String   @id @default(uuid())
  profileId           String
  email               String?
  emailSource         String?
  isQualified         Boolean  @default(false)
  /// `qualified` | `rejected` | `error`.
  ///
  /// `error` means the model never gave a verdict — unreachable, rate limited,
  /// unparseable output. It exists because `isQualified: false` cannot tell the
  /// difference between "not a good candidate" and "we never asked", and
  /// conflating them is what hid a completely broken run behind a plausible
  /// screen of rejections.
  ///
  /// An `error` row does not resolve its ProfileUrl for the stop condition, and
  /// is deleted and re-evaluated on resume — so fixing the model costs no
  /// further LinkedIn calls.
  status              String   @default("rejected")
  qualificationReason String?  @db.Text
  decidedAt           DateTime @default(now())

  profile ScrapedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ExtensionConnection {
  id              String    @id @default(uuid())
  jobId           String
  socketId        String
  connectedAt     DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  disconnectedAt  DateTime?

  job SearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─── Outreach campaigns ──────────────────────────────────────────
//
// The mail side of the product: take profiles the pipeline already found,
// draft a personalised email per contact, and send them on a delay. Ported
// from the standalone Bulk Mail Sender, which read contacts from a CSV that
// had been exported from here by hand. Contacts now come from Profile
// directly, so the export/import round trip is gone.

model Campaign {
  id           String  @id @default(uuid())
  userId       String
  name         String
  status       String  @default("PENDING") // PENDING | SENDING | COMPLETE | STOPPED | FAILED
  emailSubject String
  fromName     String?
  commonPrompt String? @db.Text

  // Milliseconds between sends, picked uniformly from the range. Gmail will
  // rate-limit and eventually flag an account that sends without any pacing.
  minDelayMs Int @default(5000)
  maxDelayMs Int @default(10000)

  // Denormalised counters so the list screen does not aggregate per row.
  totalContacts Int @default(0)
  sentCount     Int @default(0)
  failedCount   Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts CampaignContact[]

  @@index([userId, createdAt])
}

model CampaignContact {
  id         String @id @default(uuid())
  campaignId String

  // Set when the contact came from the scraping pipeline, null for a CSV
  // import. SetNull rather than Cascade: deleting a profile must not erase
  // the record that we mailed them.
  profileId String?

  name        String
  email       String
  companyName String?
  description String? @db.Text

  // A draft the user edited by hand. Present means "send this verbatim" —
  // the LLM is skipped entirely for this contact.
  customSubject String?
  customBody    String? @db.Text

  // What was actually sent, kept so a campaign is auditable after the fact.
  sentSubject String?
  sentBody    String? @db.Text

  status       String    @default("PENDING") // PENDING | GENERATING | SENDING | SUCCESS | FAILED | SKIPPED
  errorMessage String?   @db.Text
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profile  Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // One send per profile per campaign. Without this, re-importing a
  // selection silently queues a second email to the same person.
  @@unique([campaignId, profileId])
  @@index([campaignId, status])
}
