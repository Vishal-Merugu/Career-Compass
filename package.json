{
  "name": "careercompass",
  "version": "1.0.0",
  "description": "**AI-powered job discovery and professional outreach engine for LinkedIn.**",
  "main": "index.js",
  "scripts": {
    "test": "npm --prefix server run test",
    "typecheck": "npm --prefix server run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "build:prod": "cd server && npm install && npm run db:generate && npm run build",
    "build:ext": "node build-ext.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vishal-Merugu/Career-Compass.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "bugs": {
    "url": "https://github.com/Vishal-Merugu/Career-Compass/issues"
  },
  "homepage": "https://github.com/Vishal-Merugu/Career-Compass#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
