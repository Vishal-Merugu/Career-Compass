# Database URL (e.g. Postgres on local VM or hosted instance)
DATABASE_URL="postgresql://user:password@localhost:5432/careercompass?schema=public"

# JWT secret key for UI user authentication (at least 32 characters long)
JWT_SECRET="generate_a_random_32_character_long_secret_key"

# Telegram Bot configurations (Get token from @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Express server listening port
PORT=3000

# Node execution environment (development | production)
NODE_ENV="development"

# Redis Configuration (Optional cache, defaults to redis://localhost:6379 if not specified)
REDIS_URL="redis://localhost:6379"

# Shared secret required to create an account once the instance HAS an owner.
# The first registration on an empty database is always allowed, so a fresh
# deployment can bootstrap itself; every one after that must present this value
# as an `x-registration-token` header or a `registrationToken` body field.
# Leaving it unset means registration is CLOSED — which is the intended default
# for an existing deployment.
REGISTRATION_TOKEN=""

# Set to "true" only when HTTPS is actually terminated in front of the server.
# It gates the `secure` flag on the session cookie and helmet's
# `upgrade-insecure-requests` — turning it on without real TLS makes the
# dashboard unreachable (the cookie is never stored, and the browser upgrades
# the page's own assets to a port nothing listens on).
HTTPS="false"

# Comma-separated extra browser origins allowed to call the API. The dashboard
# is same-origin and the extension is matched automatically by its
# chrome-extension:// scheme, so this is normally left empty.
CORS_ORIGIN=""

# ─── Email finder ────────────────────────────────────────────────
# Layer 1: Anymail Finder's key-authenticated API. Unset, the layer is
# skipped and lookups fall through to pattern generation + SMTP verification,
# which needs no credentials. 100 free credits on signup; one credit per
# valid email found, nothing for misses, repeats free within 30 days.
# https://anymailfinder.com/email-finder-api
ANYMAILFINDER_API_KEY=""

# Layer 2: identity used in the SMTP RCPT probe. A domain you actually control
# looks like an ordinary sender; some mail servers reject a MAIL FROM whose
# domain does not resolve.
SMTP_PROBE_HELO="localhost"
SMTP_PROBE_FROM="verify@localhost"
